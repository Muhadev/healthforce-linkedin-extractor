# .env.example
# LinkedIn Posts Extractor Configuration
# Copy to .env and customize as needed

# Output directory (git-ignored)
OUT_DIR=out

# Default settings
MIN_POSTS=10
MAX_SECONDS=60
LOG_LEVEL=INFO

# Optional: Encrypt session storage at rest
# ENCRYPT_SESSION=false

# Note: No credentials are stored in env vars or files
# Session management uses only Playwright storage_state
